#!/usr/bin/env -S python3 -I -B
"""claude-resident: the launch wrapper for Claude residents (W5).

The working directory comes first. A launch outside this room passes through
untouched, whatever it names and whatever state the registry is in. A working
directory in doubt (absent, unreadable, or a link through the room that resolves
elsewhere) turns auto memory off.

Inside the room, resolves the session a launch names (--resume or --session-id)
to exactly one Claude row of the room's registry, and that row's key to its own
notebook folder, <room>/ops/etc/notebooks/<key>/. Six branches: registered
here (one match in this room: the notebook is attached), registered
elsewhere (one match in another room: the launch passes through untouched),
unregistered (no match), ambiguous (more than one match), new (no session
named) and broken registry. The last four, a registered row whose notebook
is unusable, and any error turn auto memory off for the run and attach no
notebook. No branch blocks the launch.

Three forms:

    claude-resident --dry-run [--room DIR] [--registry FILE] [--provider FILE] -- <provider arguments>
    claude-resident [--room DIR] [--registry FILE] [--provider FILE] -- <provider arguments>
    claude-resident <provider arguments>

The dry run prints, as JSON, the argv and the environment changes the run
would have, then exits 0, executing nothing and writing nothing. The other two
replace this process with the provider, so every argument, the standard
streams and the exit status pass through, after one line in a private decision
log that holds no session and no argument. The last, the bare form, is how a
launcher calls a provider. It applies only when the first argument is neither
one of the wrapper's option names nor --; it takes no options, and every
argument belongs to the provider, a later -- included.

The route to an attached notebook is a settings file naming the folder as
autoMemoryDirectory, given to the provider as its own --settings argument. That
this works on the installed provider is a native proof, named in the spec, not
asserted here. The wrapper never prints a registry value; a session identifier
appears only inside the provider's own arguments. Standard library only.

Spec: docs/ops/specs/scripts/claude-resident.md.
"""
from __future__ import annotations

import importlib.util
import json
import os
import re
import signal
import stat
import sys
import tempfile
import time
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve()
ROOM = HERE.parents[2]
REGISTRY = Path("ops") / "etc" / "resident-identities.json"
NOTEBOOKS = Path("ops") / "etc" / "notebooks"
SETTINGS = Path("logs") / "claude-resident"
ROUTE_KEY = "autoMemoryDirectory"
LOG = "decisions.log"
LOG_LIMIT = 1_048_576
OPTIONS = ("--dry-run", "--room", "--registry", "--provider")
INDEX = "MEMORY.md"
PROVIDER = "claude"
DISABLE = "CLAUDE_CODE_DISABLE_AUTO_MEMORY"
REGISTRY_LIMIT = 1_048_576
KEY_RE = re.compile(r"^[a-z0-9][a-z0-9-]*\Z")
FIELDS = ("key", "provider", "session_id", "room")
UNPROVEN = [
    "the provider executable the real run would exec, and that the exec passes every argument, the standard "
    "streams and the exit status through unchanged",
    "the route that points the provider at the attached notebook (a --settings file naming the folder, an "
    "environment variable, or another provider-documented route), and that the provider then loads that "
    "folder's MEMORY.md and writes its memory there",
    f"that {DISABLE}=1 turns auto memory off for that run in the installed provider",
    "that every launch path of the plugin (a new chat, a resume, a continue, a fork) passes its session as "
    "--resume or --session-id as measured",
    "the modes the provider gives files it writes in the notebook (F2: unknown)",
    "that the interpreter line (/usr/bin/env -S python3 -I -B) resolves in the launcher's environment",
    "that a provider rewrite of the index keeps the projected block at line 1",
    "that the route and the load limits measured on 2026-10-31 still hold on the installed provider",
    "whether the provider changes the frontmatter of notes copied into a notebook",
]
USAGE = ("usage: claude-resident --dry-run [--room DIR] [--registry FILE] [--provider FILE] -- <provider arguments>\n"
         "       claude-resident [--room DIR] [--registry FILE] [--provider FILE] -- <provider arguments>\n"
         "       claude-resident <provider arguments, the first not a wrapper option>\n")


class Broken(Exception):
    """The registry cannot be trusted; the reason names no registry value."""


def load_mind():
    """The room's mind tool, for its private-path, marker and Git rules."""
    path = HERE.parents[1] / "lib" / "scripts" / "mind.py"
    spec = importlib.util.spec_from_file_location("claude_resident_mind", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def parse(argv: list[str]):
    """(dry run?, room, registry, provider file, provider arguments), or None for a usage refusal."""
    if not argv:
        return None
    if argv[0] not in OPTIONS and argv[0] != "--":     # the bare form: no options, every argument the provider's
        return False, ROOM, ROOM / REGISTRY, None, list(argv)
    dry = argv[0] == "--dry-run"
    room, registry, provider, i = ROOM, None, None, 1 if dry else 0
    while i < len(argv) and argv[i] != "--":
        if argv[i] in ("--room", "--registry", "--provider") and i + 1 < len(argv) and argv[i + 1] != "--":
            value = Path(os.path.abspath(argv[i + 1]))
            if argv[i] == "--room":
                room = value
            elif argv[i] == "--registry":
                registry = value
            else:
                provider = value
            i += 2
            continue
        return None
    if i >= len(argv):
        return None
    return dry, room, registry or room / REGISTRY, provider, argv[i + 1:]


def named_sessions(args: list[str]) -> tuple[list[str], str]:
    """The sessions the provider's arguments name, and, when they name none, why the run counts as new."""
    names, why = [], "no --resume or --session-id names a session"
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            break
        if arg.startswith("--resume=") or arg.startswith("--session-id="):
            names.append(arg.split("=", 1)[1])
        elif arg in ("--resume", "-r", "--session-id"):
            value = args[i + 1] if i + 1 < len(args) else ""
            if value and not value.startswith("-"):
                names.append(value)
                i += 1
            else:
                why = f"{arg} names no session"
        elif arg in ("-c", "--continue"):
            why = f"{arg} names no session"
        i += 1
    if "--fork-session" in args[:i]:
        return [], "--fork-session gives the run a new session"
    return [n for n in names if n], why


def carries_settings(args: list[str]) -> bool:
    """Whether the provider's own arguments, up to its own --, already give a settings source."""
    for arg in args:
        if arg == "--":
            return False
        if arg == "--settings" or arg.startswith("--settings="):
            return True
    return False


def under(path: str, top: str) -> bool:
    return os.path.commonpath([path, top]) == top


def working_place(room: Path) -> tuple[str, str]:
    """Where this launch stands: "in" the room, "out" of it, or in "doubt" with fixed text. The kernel's resolved
    path decides, and a subfolder counts as in the room. PWD is read for the link case only: when it names this same
    directory by a path through the room while the resolved path is outside. It can only turn memory off."""
    try:
        here = os.getcwd()
    except OSError:
        return "doubt", "the working directory is absent or cannot be reached"
    if not os.access(".", os.R_OK | os.X_OK):
        return "doubt", "the working directory cannot be read"
    top = os.path.realpath(room)
    if under(here, top):
        return "in", ""
    pwd = os.environ.get("PWD", "")
    if os.path.isabs(pwd):
        try:
            same = os.path.samefile(pwd, ".")
        except OSError:
            same = False
        if same and any(under(os.path.realpath(p), top) for p in Path(pwd).parents):
            return "doubt", "the working directory is a link through the room that resolves elsewhere"
    return "out", ""


def read_rows(path: Path) -> list[dict]:
    """The registry's rows, or Broken. Read only, without following a link, at mode 0600."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        raise Broken("the registry is absent") from None
    except OSError:
        raise Broken("the registry cannot be inspected") from None
    if not stat.S_ISREG(st.st_mode):
        raise Broken("the registry is not a regular file")
    if st.st_uid != os.geteuid():
        raise Broken("the registry is not owned by this user")
    if stat.S_IMODE(st.st_mode) != 0o600:
        raise Broken(f"the registry is mode {stat.S_IMODE(st.st_mode):04o}, not 0600")
    if st.st_size > REGISTRY_LIMIT:
        raise Broken("the registry is larger than a registry can be")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            now = os.fstat(fd)
            if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
                raise Broken("the registry changed while it was read")
            data = os.read(fd, REGISTRY_LIMIT + 1)
        finally:
            os.close(fd)
        identities = json.loads(data.decode("utf-8")).get("identities")
    except Broken:
        raise
    except (OSError, UnicodeDecodeError, ValueError, AttributeError):
        raise Broken("the registry is unreadable") from None
    if not isinstance(identities, list):
        raise Broken("the registry has no identities list")
    for row in identities:
        if not isinstance(row, dict) or not all(isinstance(row.get(f), str) and row.get(f) for f in FIELDS):
            raise Broken("a registry row lacks a key, a provider, a session or a room")
        if not KEY_RE.match(row["key"]):
            raise Broken("a registry key is not a plain key")
    keys = [row["key"] for row in identities]
    if len(set(keys)) != len(keys):
        raise Broken("a registry key appears in more than one row")
    return identities


def notebook_problems(mind, room: Path, key: str) -> list[str]:
    """Why the key's folder cannot be attached, or nothing. Paths are given as tokens, never with the key."""
    folder = room / NOTEBOOKS / key
    problems = mind.private_path_problems(folder)
    if not problems:
        problems = mind.git_exposed(folder, [folder / INDEX])
    if not problems and (folder / INDEX).exists():
        try:
            text = (folder / INDEX).read_bytes().decode("utf-8")
        except (OSError, UnicodeDecodeError):
            problems = [f"{folder / INDEX} is unreadable"]
        else:
            for line in mind.nl_lines(text):
                if line.startswith(mind.MARK):
                    m = mind.BEGIN_RE.match(line) or mind.END_RE.match(line)
                    if not m or m.group(1) != key:
                        problems = [f"{folder / INDEX} holds a projection marker of another key, or a malformed one"]
                        break
    return [p.replace(str(folder), "<notebook>").replace(str(room), "<room>") for p in problems]


def place_problems(mind, room: Path, name: str) -> list[str]:
    """Why a file of the wrapper's private folder cannot be used, read only, so the dry run and the launch give one
    answer. Fixed text."""
    home = room / SETTINGS
    if not os.path.lexists(home):
        if any(p.is_symlink() for p in (home.parent, *home.parent.parents)):
            return ["a link stands in the settings folder's path"]
        if not os.path.isdir(home.parent) or not os.access(home.parent, os.W_OK | os.X_OK):
            return ["the settings folder cannot be made"]
    elif mind.private_path_problems(home):
        return ["the settings folder is not private"]
    target = home / name
    start = home if os.path.lexists(home) else home.parent
    if mind.git_exposed(start, [target]):
        return ["the settings file would not be out of Git"]
    try:
        st = os.lstat(target)
    except FileNotFoundError:
        return []
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
        return ["the settings file cannot be used"]
    return []


def settings_problems(mind, room: Path, key: str) -> list[str]:
    return place_problems(mind, room, f"{key}.settings.json")


def decide(room: Path, registry: Path, args: list[str]) -> dict:
    """One branch for this launch, and what the run would be."""
    place, doubt = working_place(room)
    if place == "doubt":
        return off("working-directory", doubt)
    if place == "out":
        return {"branch": "outside-the-room", "notebook": "none", "env": {}, "notebook_route": None,
                "auto_memory": "unchanged: the provider's default for that place",
                "reason": "the working directory is outside this room; this wrapper has no say there, so the launch "
                          "passes through untouched"}
    try:
        rows = read_rows(registry)
    except Broken as exc:
        return off("broken-registry", str(exc))
    names, why = named_sessions(args)
    if not names:
        return off("new", why)
    if len(set(names)) > 1:
        return off("ambiguous", "the arguments name more than one session")
    matches = [row for row in rows if row["provider"] == PROVIDER and row["session_id"] == names[0]]
    if not matches:
        return off("unregistered", "no Claude row of the registry names this session")
    if len(matches) > 1:
        return off("ambiguous", "more than one Claude row of the registry names this session")
    row = matches[0]
    if os.path.realpath(row["room"]) != os.path.realpath(room):
        return {"branch": "registered-elsewhere", "notebook": "none", "env": {}, "notebook_route": None,
                "auto_memory": "unchanged: the provider's default for that resident's own room",
                "reason": "one Claude row names this session, registered to another room; this wrapper has no say "
                          "over other rooms, so the launch passes through untouched"}
    return {**attach_or_off(room, row, args), "_who": row["key"]}


def attach_or_off(room: Path, row: dict, args: list[str]) -> dict:
    """A row of this room: its notebook attached, or nothing attached with the reason."""
    mind = load_mind()
    problems = notebook_problems(mind, room, row["key"])
    problems = problems or settings_problems(mind, room, row["key"])
    if problems:
        return off("registered", "the key's notebook cannot be attached: " + "; ".join(problems))
    if carries_settings(args):
        return off("registered", "the launch already carries its own --settings, so the notebook's route cannot "
                                 "be added without guessing which one the provider would honor")
    return {"branch": "registered", "notebook": "attached", "auto_memory": "the attached notebook", "env": {},
            "reason": "one Claude row names this session; its notebook folder is private, out of Git and its own",
            "notebook_route": f"a --settings file naming the folder as {ROUTE_KEY}, the provider's documented route; "
                              "unproven until the native proofs (see unproven)",
            "_key": row["key"]}


def off(branch: str, reason: str) -> dict:
    return {"branch": branch, "notebook": "none", "auto_memory": "off", "env": {DISABLE: "1"}, "reason": reason,
            "notebook_route": None}


def runnable(path) -> bool:
    return os.path.isfile(path) and os.access(path, os.X_OK) and os.path.realpath(path) != os.path.realpath(HERE)


def find_provider(named, env: dict):
    """The file to exec: the one named, or the first `claude` on PATH. Never this wrapper, and never a relative
    or empty PATH entry, which would run whatever the working directory holds."""
    if named is not None:
        return str(named) if runnable(named) else None
    for part in env.get("PATH", "").split(os.pathsep):
        if os.path.isabs(part) and runnable(Path(part) / PROVIDER):
            return str(Path(part) / PROVIDER)
    return None


def make_home(mind, room: Path) -> Path:
    """The wrapper's private folder, made at 0700 if absent. Two first launches can meet here: the second finds it
    made, and checks it."""
    home = room / SETTINGS
    if not os.path.lexists(home):
        try:
            os.mkdir(home, 0o700)
        except FileExistsError:
            if mind.private_path_problems(home):
                raise OSError("the settings folder is not private") from None
    return home


def write_settings(mind, room: Path, key: str) -> Path:
    """The route: one 0600 file per key, in a 0700 folder under logs/, replaced atomically and only when it
    differs. The exec leaves nothing behind to clean up, so a launch must leave no growth. Raises on any doubt."""
    if settings_problems(mind, room, key):       # asked again at the launch: it may have changed since the decision
        raise OSError("the settings place cannot be used")
    home = make_home(mind, room)
    target = home / f"{key}.settings.json"
    data = (json.dumps({ROUTE_KEY: str(room / NOTEBOOKS / key)}, indent=2, sort_keys=True) + "\n").encode("utf-8")
    try:
        st = os.lstat(target)
    except FileNotFoundError:
        st = None
    if st is not None and stat.S_ISREG(st.st_mode):
        if stat.S_IMODE(st.st_mode) == 0o600 and st.st_nlink == 1 and target.read_bytes() == data:
            return target
    fd, tmp = tempfile.mkstemp(dir=home, prefix=f".{target.name}.")
    try:
        os.fchmod(fd, 0o600)
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(tmp, target)
    except BaseException:
        if fd != -1:
            os.close(fd)
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise
    return target


def record(room: Path, result: dict, env: dict, provider: str) -> None:
    """One line in the private decision log: what this launch got, so a lost notebook can be seen afterwards. It holds
    the branch, the fixed reason and, for a row of this room, its key: no session, argument, room or person. Any doubt
    writes nothing, and nothing here can stop the launch."""
    try:
        mind = load_mind()
        if place_problems(mind, room, LOG):
            return
        home = make_home(mind, room)
        target = home / LOG
        try:
            if os.lstat(target).st_size >= LOG_LIMIT:
                if place_problems(mind, room, f"{LOG}.1"):   # the earlier file answers to the same place rules
                    return
                os.replace(target, home / f"{LOG}.1")
        except FileNotFoundError:
            pass
        row = {"time": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "branch": result["branch"],
               "notebook": result["notebook"], "memory_off": env.get(DISABLE) == "1", "reason": result["reason"],
               "key": result.get("_who"), "provider": provider}
        log = os.open(target, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
        try:
            st = os.fstat(log)
            if stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid() and st.st_nlink == 1:
                if stat.S_IMODE(st.st_mode) != 0o600:
                    os.fchmod(log, 0o600)
                os.write(log, (json.dumps(row, sort_keys=True) + "\n").encode("utf-8"))
        finally:
            os.close(log)
    except Exception:
        pass


def launch(result: dict, room: Path, named, args: list[str]) -> int:
    """Replace this process with the provider. Returns only when that cannot happen."""
    env = dict(os.environ)
    env.update(result["env"])
    extra = []
    if result["notebook"] == "attached":
        try:
            extra = ["--settings", str(write_settings(load_mind(), room, result["_key"]))]
        except Exception:                    # no route, no notebook: auto memory off, the launch not blocked
            env[DISABLE] = "1"
            result = {**result, "notebook": "none", "reason": "the notebook's route could not be written at the launch"}
    provider = find_provider(named, env)
    record(room, result, env, "found" if provider else "none")
    if provider is None:
        sys.stderr.write("claude-resident: no provider executable was found\n")
        return 127
    for name in ("SIGPIPE", "SIGXFSZ"):      # Python ignores these at start, and an ignored signal survives an exec
        signal.signal(getattr(signal, name), signal.SIG_DFL)
    try:
        os.execve(provider, [provider, *extra, *args], env)
    except OSError as exc:
        sys.stderr.write(f"claude-resident: the provider could not be executed ({exc.__class__.__name__})\n")
        record(room, result, env, "could not be executed")
    return 126


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    try:
        parsed = parse(argv)
    except OSError:                          # a relative option value under a working directory that is gone
        parsed = None
    if parsed is None:
        sys.stderr.write(USAGE)
        return 2
    dry, room, registry, named, args = parsed
    try:
        result = decide(room, registry, args)
    except Exception as exc:                 # any error: no notebook, auto memory off, the launch not blocked
        result = off("error", f"the wrapper could not decide ({exc.__class__.__name__}); nothing is attached")
    if not dry:
        return launch(result, room, named, args)
    route = ["--settings", "<settings>"] if result.pop("_key", None) else []
    result.pop("_who", None)
    result.update(mode="dry-run", executed=False, argv=["<provider>", *route, *args], unproven=UNPROVEN,
                  provider=find_provider(named, {**os.environ, **result["env"]}))
    sys.stdout.write(json.dumps(result, indent=2, sort_keys=True) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
