#!/usr/bin/env python3
"""Tests for ops/lib/scripts/{{WORD}}.py, on synthetic inputs only. Standard library only.

Skeleton generated by ops/bin/template on {{DATE}}. No real body is read. Run:

    python3 -I -B tools/test/test_{{WORD}}.py

Behavior cases to write:
{{BEHAVIOR_TESTS}}

Each case builds its own inputs in a temporary directory. When the tool is
built, replace test_skeleton_refuses_until_built with real cases.
"""
import subprocess
import sys
import unittest
from pathlib import Path

TOOL = Path(__file__).resolve().parents[2] / "ops" / "lib" / "scripts" / "{{WORD}}.py"


def run(*args):
    return subprocess.run([sys.executable, "-I", "-B", str(TOOL), *args],
                          capture_output=True, text=True, timeout=60)


class SkeletonTest(unittest.TestCase):
    def test_tool_exists(self):
        self.assertTrue(TOOL.is_file(), TOOL)

    def test_skeleton_refuses_until_built(self):
        r = run()
        self.assertEqual(r.returncode, 2, r.stderr)
        self.assertIn("skeleton", r.stderr)

    @unittest.skip("behavior tests not yet written; see the module docstring")
    def test_behavior(self):
        pass


if __name__ == "__main__":
    unittest.main()
