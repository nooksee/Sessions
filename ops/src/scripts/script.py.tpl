#!/usr/bin/env python3
"""{{WORD}}: {{PURPOSE}}

Skeleton generated by ops/bin/template on {{DATE}}. Nothing here is built.
Spec: docs/ops/specs/scripts/{{WORD}}.md. Tests: tools/test/test_{{WORD}}.py.

{{READS_AND_WRITES}}

House rules, fixed by the template: session bodies are read-only, and message
content is never read or printed. Rebuildable output goes in storage/; anything
that cannot be rebuilt goes in archives/, archives/receipts/ or custody, never in
storage/.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

SESSIONS = Path(__file__).resolve().parents[3]
SPEC = SESSIONS / "docs" / "ops" / "specs" / "scripts" / "{{WORD}}.md"


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="{{WORD}}", description="skeleton; see docs/ops/specs/scripts/{{WORD}}.md")
    # Arguments: none until the tool is built; its spec names them.
    return ap


def main(argv=None) -> int:
    build_parser().parse_args(argv)
    print("refused: {{WORD}} is a skeleton; nothing is built (see docs/ops/specs/scripts/{{WORD}}.md)", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
