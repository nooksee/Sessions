# Sessions: a root allowlist. Everything is ignored unless admitted by name below.
# What is private, and why, is stated here on purpose: nothing is hidden about what is hidden.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/PoT.md
!/RoR.md
!/DOCTRINE.md
!/INDEX.md
!/NOW.md
!/.github/
!/.github/workflows/
!/.github/workflows/sessions-gates.yml
!/ops/
!/tools/
!/docs/
!/storage/
!/var/
/var/*
!/var/README.md
!/var/tmp/
/var/tmp/*
!/var/tmp/.gitignore
!/var/tmp/.gitkeep
/docs/*
!/docs/INDEX.md
!/docs/MANUAL.md
!/docs/START-HERE.md
!/docs/ops/
# docs/reviews/: read-only reviews of the repository, admitted as public copies through the redact tool
!/docs/reviews/
/docs/reviews/*
!/docs/reviews/sessions-review-20261105.md
!/archives/
/archives/*
!/archives/PoT-38854647.md
!/archives/PoT-draft-v0-de5d6c0c.md
!/archives/PoT-ef2e16c0.md
!/archives/PoT-5b93c454.md
!/archives/PoT-5a2a17a9.md
!/archives/PoT-457fe859.md
!/archives/PoT-authority-457fe859.md
!/archives/PoT-db1586ff.md
!/archives/PoT-authority-db1586ff.md
!/archives/PoT-744238f2.md
!/archives/PoT-authority-744238f2.md
!/archives/board-history-20261105.md
!/archives/board-history-20261107.md
!/archives/receipts/
/archives/receipts/*
!/archives/receipts/repository-bootstrap-20261031.md
!/archives/receipts/landing-stage-a-20261101.md
!/archives/receipts/landing-stage-d-20261101.md
!/archives/receipts/custody-sessions-evidence-20261101.md
!/archives/receipts/block-6-evidence-20261101.md
!/archives/receipts/custody-sessions-receipts-20261101.md
!/archives/receipts/stage-b-20261101.md
!/archives/receipts/state-cutover-20261104.md
!/archives/receipts/stage-c-20261101.md
!/archives/receipts/first-render-20261104.md
!/archives/receipts/history-rewrite-20261104.md
!/archives/receipts/joe-owned-storage-disposition-20261104.md
!/archives/receipts/README.md
# archives/packets/: one kept leaf per landed dispatch packet, written only by packet.py; public by construction
!/archives/packets/
/archives/packets/*
!/archives/packets/README.md
!/archives/packets/DP-SES-[0-9][0-9][0-9][0-9].md
!/logs/
/logs/*
!/logs/.gitkeep

# Private by design (PoT 5.1, 5.4). These exist on the host and never enter Git:
#   archives/receipts/*  records that quote the operator and name host paths; admitted one by one after redaction
#   archives/legacy/     frozen copies of retired lanes, including runtime data that carries session identifiers
#   archives/RoR-words.md  the ledger's source: each entry with the operator's words in place; RoR.md is its derived copy (PoT 1.2.10, 1.3.2)
#   archives/words/      the sources of other records that quote the operator; their tracked copies are derived by the redact tool (PoT 1.2.10)
#   MIND.md, archives/mind/  the mind: a pointer index and its leaves (ledger under logs/mind/)
#   .claude/             the room's own Claude settings, host-local; settings.json turns auto memory off (docs/ops/README.md)
#   .claude-code-gui/    the plugin's project setting, host-local; nothing in this room reads it
#   ops/etc/*            the registry, roster, promotions, host bindings and any other binding in any format: identity; only .gitkeep is admitted
#   logs/*               telemetry: output, not a record
#   storage/             only its declared skeleton is versioned; payload stays private by default
#   var/tmp/             task-local scratch; only the skeleton is admitted
#   HANDOFF.md           the Integrator's own handoff
# Storage admission is defined once, in storage/.gitignore.
/MIND.md
/archives/legacy/
/archives/RoR-words.md
/archives/words/
/ops/etc/*
!/ops/etc/.gitkeep
/HANDOFF.md
/.venv/
/.idea/
/.claude/
/.claude-code-gui/
/.pytest_cache/
**/__pycache__/
*.py[cod]
*.jsonl
*.jsonl.*
*.PRE-RELABEL
.env
.env.*
*.pem
*.key
