# Sessions repository bootstrap: classify a lane before admitting it.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/PoT.md
!/RoR.md
!/DOCTRINE.md
!/INDEX.md
!/START-HERE.md
!/NOW.md
!/ops/
!/tools/
!/docs/
/docs/*
!/docs/INDEX.md
!/docs/MANUAL.md
!/docs/START-HERE.md
!/docs/ops/
!/archives/
/archives/*
!/archives/PoT-38854647.md
!/archives/PoT-ef2e16c0.md
!/archives/PoT-draft-v0-de5d6c0c.md
/archives/legacy/Resident-Center/
/archives/legacy/Config/
/archives/legacy/Evidence/
!/logs/
/logs/*
!/logs/.gitkeep

# Private continuity and working lanes remain outside Git (storage/ holds lab/ and candidates/, which carry session bodies;
# ops/etc/ holds the registry, the promotions, the launcher roster and the bindings).
/ops/etc/resident-identities.json
/ops/etc/promoted-workers.json
/ops/etc/residents.json
/ops/etc/host-bindings.json
/storage/
/MIND.md
/archives/MIND-*
/archives/surfaces/
/.venv/
/.idea/
/.claude/
/.pytest_cache/
**/__pycache__/
*.py[cod]
*.jsonl
*.jsonl.*
*.PRE-RELABEL
.env
.env.*
*.pem
*.key
!/Receipts/
/Receipts/*
!/Receipts/repository-bootstrap-20261031.md
!/Receipts/landing-stage-a-20261101.md
/ops/etc/*.json
